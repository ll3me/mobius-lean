private def seed (u v : B) := seeds[16*u.toNat+v.toNat]!
private def basis (d e : B) := bases[16*d.toNat+e.toNat]!
private def fstRect (w : PairSeed) := Mobius.TwoPhases.certificate[w.first]!
private def sndRect (w : PairSeed) := Mobius.TwoPhases.certificate[w.second]!
private def image (w : PairSeed) (r : Rectangle) (turn : Bool) :=
  flip (mapRect (frame w.direct).eval r) turn
private def offset (w : PairSeed) : Cell :=
  let r := image w (fstRect w) w.turnFirst
  (r.1,r.2.1)

private def Valid (w : PairSeed) (u v : B) : Prop :=
  inverseTest (frame w.direct) (frame w.inverse) = true ∧
  fstRect w ∈ Mobius.TwoPhases.certificate ∧ sndRect w ∈ Mobius.TwoPhases.certificate ∧
  translate (offset w) (image w (fstRect w) w.turnFirst) = (0,0,1) ∧
  translate (offset w) (image w (sndRect w) w.turnSecond) = (u,v,2)

private instance (w : PairSeed) (u v : B) : Decidable (Valid w u v) := by unfold Valid; infer_instance

private theorem valid_seeds : ∀ u v : B, Valid (seed u v) u v := by decide

private theorem valid_bases : ∀ d e : B, d ≠ 0 → e ≠ 0 → d ≠ e →
    inverseTest (frame (basis d e).1) (frame (basis d e).2) = true ∧
    (frame (basis d e).1).eval 1 = d ∧ (frame (basis d e).1).eval 2 = e := by decide

/-- Simultaneous linear transport of the two standard directions. -/
theorem directions_chart (d e : B) (hd : d ≠ 0) (he : e ≠ 0) (hne : d ≠ e) :
    ∃ g : Chart, g.act 1 = d ∧ g.act 2 = e := by
  obtain ⟨good, h₁, h₂⟩ := valid_bases d e hd he hne
  exact ⟨chart _ _ good, h₁, h₂⟩

/-- For directions 1 and 2, every one of the 256 relative anchor positions
occurs. The two optional turns preserve directed-square voltage. -/
theorem standard_pair (u v : B) :
    ∃ (g : Chart) (s : Cell) (r q : Rectangle) (a b : Bool),
      r ∈ Mobius.TwoPhases.certificate ∧ q ∈ Mobius.TwoPhases.certificate ∧
      translate s (flip (mapRect g.act r) a) = (0,0,1) ∧
      translate s (flip (mapRect g.act q) b) = (u,v,2) := by
  let w := seed u v
  obtain ⟨good, h₁, h₂, hr, hq⟩ := valid_seeds u v
  exact ⟨chart _ _ good,offset w,fstRect w,sndRect w,w.turnFirst,w.turnSecond,h₁,h₂,hr,hq⟩

end Mobius.Rigidity
